{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 100,
  "proseWrap": "preserve",
  "overrides": [
    {
      "files": ["*.mdx"],
      "options": {
        "parser": "mdx",
        "printWidth": 100,
        "proseWrap": "preserve"
      }
    },
    {
      "files": ["*.md"],
      "options": {
        "parser": "markdown",
        "printWidth": 100,
        "proseWrap": "preserve"
      }
    }
  ]
}
