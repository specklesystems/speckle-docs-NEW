{
  "scripts": {
    "dev": "mint dev --port 3333",
    "valid": "mint validate",
    "check-links": "mint broken-links --check-anchors --check-redirects --check-snippets",
    "check-links:external": "mint broken-links --check-anchors --check-redirects --check-snippets --check-external",
    "check:a11y": "mint a11y",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:changed": "bash scripts/format-check-changed.sh",
    "lint:md": "bash scripts/lint-md-changed.sh",
    "lint:md:all": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:md:changed": "bash scripts/lint-md-changed.sh",
    "check:format-lint": "pnpm format:check:changed && pnpm lint:md:changed",
    "check:format-lint:all": "pnpm format:check && pnpm lint:md:all",
    "check:format-lint:changed": "pnpm format:check:changed && pnpm lint:md:changed",
    "check:validate": "pnpm valid",
    "check:links": "pnpm check-links",
    "check:links:external": "pnpm check-links:external",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:orphans": "node scripts/check-orphans.mjs",
    "check:orphans:list": "node scripts/check-orphans.mjs --list",
    "check:assets": "node scripts/check-assets.mjs",
    "check:structure": "pnpm check:redirects && pnpm check:orphans && pnpm check:assets",
    "check": "pnpm check:changed",
    "check:changed": "pnpm check:format-lint:changed && pnpm check:validate && pnpm check:structure && pnpm check:links && pnpm check:a11y",
    "check:all": "pnpm check:format-lint:all && pnpm check:validate && pnpm check:structure && pnpm check:links && pnpm check:a11y",
    "uac": "universal-ai-config",
    "prepare": "husky",
    "tables:align": "node scripts/align-md-tables.mjs",
    "prettier-commit": "git pull || true && pnpm format && git add . && git commit -m 'prettier' && git push"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/cli": "^0.1.11",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.22.0",
    "mint": "^4.2.548",
    "prettier": "^3.8.3",
    "universal-ai-config": "^1.11.2"
  },
  "engines": {
    "node": "^22.17.1"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
