{
  "scripts": {
    "dev": "mint dev --port 3333",
    "valid": "mint validate",
    "check-links": "mint broken-links --check-anchors",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:changed": "bash scripts/format-check-changed.sh",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint:md:changed": "bash scripts/lint-md-changed.sh",
    "check": "pnpm format:check && pnpm lint:md && pnpm valid && pnpm check-links",
    "check:changed": "pnpm format:check:changed && pnpm lint:md:changed && pnpm valid && pnpm check-links",
    "uac": "universal-ai-config"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/cli": "^0.1.11",
    "jiti": "^2.6.1",
    "markdownlint-cli2": "^0.22.0",
    "mint": "^4.2.548",
    "prettier": "^3.8.3",
    "universal-ai-config": "^1.11.2"
  },
  "engines": {
    "node": "^22.17.1"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
