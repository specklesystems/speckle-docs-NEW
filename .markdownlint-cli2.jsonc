{
  // Mintlify MDX docs — keep MD036 + MD060 on (user authoring rules).
  // Note: markdownlint-cli2 compiles frontMatter with the `u` flag only (no `m`),
  // so avoid ^/$ line anchors inside the body — use [\s\S] instead.
  "gitignore": true,
  "frontMatter": "^---\\r?\\n[\\s\\S]*?\\r?\\n---\\r?\\n",
  "globs": ["**/*.{md,mdx}"],
  "ignores": [
    "node_modules/**",
    ".mintlify/**",
    ".cursor/**",
    ".claude/**",
    // Agent config (atlas ADR-0008): AGENTS.md carries a sync-written block, and aligned-table
    // padding (MD060) in agent context only costs tokens.
    ".agents/**",
    "AGENTS.md",
    "agents/**",
    "docs/agents/**",
    "**/notebooks/**"
  ],
  "config": {
    "default": true,

    // Prettier owns wrapping
    "MD013": false,

    // Mintlify / MDX JSX components
    "MD033": false,

    // YAML frontmatter precedes the title
    "MD041": false,

    // Tabs / repeated section labels
    "MD024": {
      "siblings_only": true
    },

    // FAQ-style headings may end with ?
    "MD026": {
      "punctuation": ".,;:!"
    },

    // ATX headings only
    "MD003": {
      "style": "atx"
    },

    // Match Prettier nested list indent
    "MD007": {
      "indent": 2
    },

    // Authoring: no emphasis-as-heading; aligned table pipes
    "MD036": true,
    "MD060": {
      "style": "aligned"
    },

    // Emphasis * vs _ style: Prettier and migrated docs disagree; not an authoring rule
    "MD049": false,

    // MDX often nests fences/lists inside components
    "MD031": false,
    "MD032": false,
    "MD046": false,

    // Multiple H1s appear in some migrated pages
    "MD025": false,

    // Common in migrated docs / Mintlify callouts — tune later
    "MD037": false,
    "MD040": false,
    "MD045": false,
    "MD059": false,
    "MD029": false,
    "MD034": false,
    "MD009": false,
    "MD012": false
  }
}
